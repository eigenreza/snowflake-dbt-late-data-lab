# Copy to .env (gitignored) and fill in. Only needed for the Snowflake target;
# the DuckDB target runs without any of these.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=LDL_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/ldl_svc_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_DATABASE=LATE_DATA_LAB

# Reporting service user for Power BI Desktop (key pair; see powerbi/MODEL-GUIDE.md)
SNOWFLAKE_REPORT_USER=LDL_REPORT_SVC
SNOWFLAKE_REPORT_PRIVATE_KEY_PATH=/path/to/ldl_report_rsa_key.p8
SNOWFLAKE_REPORT_PRIVATE_KEY_PASSPHRASE=
